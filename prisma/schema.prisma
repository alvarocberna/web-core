

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Proyecto {
  id                      String   @id @default(uuid())
  nombreProyecto          String   @map("nombre_proyecto") @db.VarChar(200)
  descripcion             String   @db.VarChar(500)
  cliente                 String
  fechaInicio             DateTime @map("fecha_inicio")
  activo                  Boolean    @default(true)
  //REL N:M
  usuario                 Usuario[] @relation("fk_usu_pro")
  articulos               Articulos[] @relation("fk_arts_pro")
  articulo                Articulo[] @relation("fk_art_pro")
  secArticulo             SecArticulo[] @relation("fk_secart_pro")
  equipo                  Equipo[] @relation("fk_equ_pro")
  empleado                Empleado[] @relation("fk_emp_pro")
  secEmpleado             SecEmpleado[] @relation("fk_secemp_pro")
  servicios               Servicios[] @relation("fk_sers_pro")
  servicio                Servicio[] @relation("fk_ser_pro")
  secServicio             SecServicio[] @relation("fk_secser_pro")
  testimonios             Testimonios[] @relation("fk_tess_pro")
  testimonio              Testimonio[] @relation("fk_tes_pro")
  actividad               Actividad[] @relation("fk_act_pro")
  click                   Click[] @relation("fk_cli_pro")
}

model Usuario {
  id                     String   @id @default(uuid())
  nombre                 String   @db.VarChar(50)
  apellido               String   @db.VarChar(50)
  email                  String   @unique @db.VarChar(100)
  fechaCreacion          DateTime
  password               String
  hashedRt               String?
  rol                    String
  imgUrl                 String? @map("img_url") @default("")
  imgAlt                 String? @map("img_alt") @default("") @db.VarChar(100)
  proyectoId             String @map("proyecto_id")
  //REL M:N
  proyecto               Proyecto @relation(name: "fk_usu_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
}

model Articulos {
  id                    String     @id @default(uuid())
  titulo                String     @default("Articulos") @db.VarChar(200)
  descripcion           String?    @db.VarChar(500)
  activo                Boolean    @default(true)
  aprobar               Boolean    @default(false)
  habilitado            Boolean    @default(true)
  notificacion          Boolean    @default(false)
  proyectoId            String @map("proyecto_id")
  //REL M:N
  proyecto              Proyecto @relation(name: "fk_arts_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
  //REL N:M
  articulo              Articulo[] @relation("fk_art_arts")
}

model Articulo {
    id                   String              @id @default(uuid())
    nroArticulo          Int                 @map("nro_articulo")
    titulo               String              @db.VarChar(200)
    subtitulo            String?             @db.VarChar(500)
    autor                String
    fechaPublicacion     DateTime            @map("fecha_publicacion")
    fechaActualizacion   DateTime?           @map("fecha_actualizacion")
    status               String
    activo               Boolean
    slug                 String
    imageUrl             String?             @map("image_url")
    imageAlt             String?             @map("image_alt")
    imagePosition        String?             @map("image_position")
    proyectoId           String              @map("proyecto_id")
    articulosId          String              @map("articulos_id")
    //REL M:N
    proyecto             Proyecto @relation(name: "fk_art_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
    articulos            Articulos @relation(name: "fk_art_arts", fields: [articulosId], references: [id], onDelete: Cascade)
    //REL N:M
    secArticulo          SecArticulo[]      @relation("fk_secart_art")
    actividad            Actividad[]        @relation("fk_act_art")
}

model SecArticulo {
    id                   String    @id @default(uuid())
    nroSeccion           Int       @map("nro_seccion")
    tituloSec            String?   @map("titulo_sec") @db.VarChar(200)
    contenidoSec         String?   @map("contenido_sec")
    imageUrl             String?   @map("image_url")
    imageAlt             String?   @map("image_alt") @db.VarChar(100)
    imagePosition        String?   @map("image_position")
    proyectoId           String    @map("proyecto_id")
    articuloId           String    @map("articulo_id")
    //REL M:N
    proyecto             Proyecto @relation(name: "fk_secart_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
    articulo             Articulo @relation(name: "fk_secart_art", fields: [articuloId], references: [id], onDelete: Cascade)
}

model Equipo {
  id                     String     @id @default(uuid())
  titulo                 String     @default("Equipo")      @db.VarChar(200)
  descripcion            String?                            @db.VarChar(500)
  activo                 Boolean    @default(true)
  notificacion           Boolean    @default(false)
  habilitado             Boolean    @default(true)
  proyectoId             String @map("proyecto_id")
  //REL M:N
  proyecto               Proyecto @relation(name: "fk_equ_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
  //REL N:M
  empleado               Empleado[] @relation("fk_emp_equ")
}

model Empleado {
  id                     String   @id @default(uuid())
  nombrePrimero          String   @map("nombre_primero") @db.VarChar(50)
  nombreSegundo          String?  @map("nombre_segundo") @db.VarChar(50)
  apellidoPaterno        String   @map("apellido_paterno") @db.VarChar(50)
  apellidoMaterno        String?  @map("apellido_materno") @db.VarChar(50)
  profesion              String?   @db.VarChar(100)
  especialidad           String?  @db.VarChar(200)
  descripcion            String?  @db.VarChar(500)
  orden                  Float?
  activo                 Boolean
  slug                   String   @default("")
  imgUrl                 String?  @map("img_url")
  imgAlt                 String?  @map("img_alt")
  proyectoId             String   @map("proyecto_id")
  equipoId               String   @map("equipo_id")
  //REL M:N
  proyecto               Proyecto @relation(name: "fk_emp_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
  equipo                 Equipo @relation(name: "fk_emp_equ", fields: [equipoId], references: [id], onDelete: Cascade)
  //REL N:M
  secEmpleado            SecEmpleado[]      @relation("fk_secemp_emp")
}

model SecEmpleado {
    id                   String    @id @default(uuid())
    nroSeccion           Int       @map("nro_seccion")
    tituloSec            String?   @map("titulo_sec") @db.VarChar(200)
    contenidoSec         String?   @map("contenido_sec")
    imageUrl             String?   @map("image_url")
    imageAlt             String?   @map("image_alt") @db.VarChar(100)
    imagePosition        String?   @map("image_position")
    proyectoId           String    @map("proyecto_id")
    empleadoId           String    @map("empleado_id")
    //REL M:N
    proyecto             Proyecto @relation(name: "fk_secemp_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
    empleado             Empleado @relation(name: "fk_secemp_emp", fields: [empleadoId], references: [id], onDelete: Cascade)
}

model Servicios {
  id                    String     @id @default(uuid())
  titulo                String     @default("Servicios") @db.VarChar(200)
  descripcion           String?    @db.VarChar(500)
  icono                 String?
  activo                Boolean    @default(true)
  notificacion          Boolean    @default(false)
  habilitado            Boolean    @default(true)
  proyectoId            String @map("proyecto_id")
  //REL M:N
  proyecto              Proyecto @relation(name: "fk_sers_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
  //REL N:M
  servicio              Servicio[] @relation("fk_ser_sers")
}

model Servicio {
  id                    String   @id @default(uuid())
  nombreServicio        String   @map("nombre_servicio") @db.VarChar(200)
  descripcion           String?  @db.VarChar(500)
  valor                 Int?
  nombrePromocion       String?  @map("nombre_promocion") @db.VarChar(200)
  porcentajeDescuento   Int?     @map("porcentaje_descuento")
  destacado             Boolean
  icono                 String?
  orden                 Float?
  activo                Boolean
  slug                  String  @default("-")
  imgUrl                String? @map("img_url")
  imgAlt                String? @map("img_alt")
  proyectoId            String @map("proyecto_id")
  serviciosId           String @map("servicios_id")
  //REL M:N
  proyecto              Proyecto @relation(name: "fk_ser_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
  servicios             Servicios @relation(name: "fk_ser_sers", fields: [serviciosId], references: [id], onDelete: Cascade)
  //REL N:M
  secServicio           SecServicio[]      @relation("fk_secser_ser")
}

model SecServicio {
    id                   String    @id @default(uuid())
    nroSeccion           Int       @map("nro_seccion")
    tituloSec            String?   @map("titulo_sec") @db.VarChar(200)
    contenidoSec         String?   @map("contenido_sec")
    imageUrl             String?   @map("image_url")
    imageAlt             String?   @map("image_alt") @db.VarChar(100)
    imagePosition        String?   @map("image_position")
    proyectoId           String    @map("proyecto_id")
    servicioId           String    @map("servicio_id")
    //REL M:N
    proyecto             Proyecto @relation(name: "fk_secser_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
    servicio             Servicio @relation(name: "fk_secser_ser", fields: [servicioId], references: [id], onDelete: Cascade)
}

model Testimonios {
  id                    String      @id @default(uuid())
  titulo                String      @default("Testimonios") @db.VarChar(200)
  descripcion           String?     @db.VarChar(500)
  activo                Boolean     @default(true)
  aprobar               Boolean     @default(false)
  notificacion          Boolean     @default(false)
  habilitado            Boolean     @default(true)
  proyectoId            String @map("proyecto_id")
  //REL M:N
  proyecto              Proyecto @relation(name: "fk_tess_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
  //REL N:M
  testimonio            Testimonio[] @relation("fk_tes_tess")
}

model Testimonio {
  id                    String     @id @default(uuid())
  nombre                String     @db.VarChar(50)
  apellido              String     @db.VarChar(50)
  correo                String     @db.VarChar(100)
  descripcion           String     @db.VarChar(500)
  calificacion          Int?
  status                String
  fechaCreacion         DateTime @map("fecha_creacion")
  proyectoId            String @map("proyecto_id")
  testimoniosId         String @map("testimonios_id")
  //REL M:N
  proyecto              Proyecto @relation(name: "fk_tes_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
  testimonios           Testimonios @relation(name: "fk_tes_tess", fields: [testimoniosId], references: [id], onDelete: Cascade)
}

model Actividad {
    id                    String   @id @default(uuid())
    accion                String
    tituloArticulo        String   @map("titulo_articulo")
    responsable           String
    fecha                 DateTime
    proyectoId            String   @map("proyecto_id")
    articuloId            String?  @map("articulo_id")
    //REL M:N
    proyecto              Proyecto @relation(name: "fk_act_pro", fields: [proyectoId], references: [id], onDelete: Cascade)
    articulo              Articulo? @relation(name: "fk_act_art", fields: [articuloId], references: [id], onDelete: SetNull)
}

model Click {
    id                    String    @id @default(uuid())
    fecha                 DateTime
    entidadNombre         String    @map("entidad_nombre")
    proyectoId            String    @map("proyecto_id")
    entidadId             String    @map("entidad_id")
    //REL M:N
    proyecto               Proyecto @relation(name: "fk_cli_pro", fields: [proyectoId], references: [id], onDelete: Cascade)

}
